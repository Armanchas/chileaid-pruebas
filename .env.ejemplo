DB_USER=chileaid_user
DB_PASSWORD=ChileAid2026!
DB_NAME=chileaid_db
REGISTRY_IMAGE=chileaid

SECRET_KEY=8f4e3b2a1c9d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f
ALGORITHM=HS256
# Alineado con la duración de la cookie de sesión del frontend (7 días,
# `COOKIE_MAX_AGE` en useAuth.ts); no hay refresh-token flow todavía, así que
# un valor menor deja al usuario "logueado" en la UI pero con 401 en cada
# request una vez que el JWT expira.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Orígenes permitidos para CORS (separados por comas). docker-compose.yml usa
# https://chileaid.armin.moe (prod) como default si esta var no está seteada,
# así que en dev local hay que fijarla explícitamente o cualquier POST/DELETE
# desde el frontend (http://localhost:3000) fallará por CORS aunque el
# backend responda bien.
# - Prod (EC2, rama main):        CORS_ORIGINS=https://chileaid.armin.moe
# - Dev remoto (VPS, rama develop): CORS_ORIGINS=https://chileaid-dev.armin.moe
# - Dev local:                     CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=https://chileaid.url.com

# Geocoding de direcciones (Nominatim/OpenStreetMap, RF-05). Opcional: el backend
# usa el servicio público por defecto. Para volumen alto, apuntar a una instancia
# self-host. El User-Agent identifica la app (requisito de la política de Nominatim).
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=ChileAid/1.0 (https://chileaid.armin.moe)

# URL pública del backend (usada por el navegador del usuario)
# - Prod (EC2, rama main):           https://api.armin.moe
# - Dev remoto (VPS, rama develop):  https://api-dev.armin.moe
NUXT_PUBLIC_API_BASE=https://api.url.com

# URL interna del backend (usada por el SSR desde dentro de Docker)
NUXT_API_BASE_SERVER=http://backend:8000