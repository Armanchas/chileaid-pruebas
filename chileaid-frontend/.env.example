# URL del backend para el NAVEGADOR (y para SSR en desarrollo local).
NUXT_PUBLIC_API_BASE=http://localhost:8000

# URL del backend para el SSR (servidor Nuxt). Solo hace falta cuando el backend
# NO está en "localhost" desde el contenedor, p. ej. Docker Compose (nombre de
# servicio "backend"). Si se omite, cae a NUXT_PUBLIC_API_BASE.
# NUXT_API_BASE_SERVER=http://backend:8000
